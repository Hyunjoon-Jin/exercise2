# =============================================================================
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요.
# .env.local 은 .gitignore 에 포함되어 있습니다 — 절대 커밋하지 마세요.
# =============================================================================

# Supabase 프로젝트 설정 → Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 프로젝트 생성 시점에 따라 둘 중 하나가 발급됩니다. 있는 쪽만 채우면 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이메일 인증 링크의 리디렉션 대상. 로컬 개발은 아래 값 그대로.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 아래는 Phase 3(검진 자동판독)에서 사용합니다. 지금은 비워 두세요.
# -----------------------------------------------------------------------------

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되므로 절대 금지.
ANTHROPIC_API_KEY=

# 검진 파일 삭제 등 RLS 를 우회해야 하는 서버 작업용. 서버 전용.
SUPABASE_SERVICE_ROLE_KEY=
