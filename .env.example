# =============================================================================
# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요.
# .env.local 은 .gitignore 에 포함되어 있습니다 — 절대 커밋하지 마세요.
# =============================================================================

# Supabase 프로젝트 설정 → Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 프로젝트 생성 시점에 따라 둘 중 하나가 발급됩니다. 있는 쪽만 채우면 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이메일 인증 링크의 리디렉션 대상. 로컬 개발은 아래 값 그대로.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RLS 를 우회하는 서버 작업용(복약 알림 발송 등). 서버 전용 — 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 복약 알림 (Phase 1)
#
# 비워 두면 알림 기능만 꺼진 채로 나머지는 정상 동작합니다.
# 키 쌍 생성:  npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소. mailto: 또는 https: 형식.
VAPID_SUBJECT=mailto:you@example.com

# /api/push/dispatch 를 호출할 스케줄러의 인증 토큰.
# 설정하지 않으면 발송 엔드포인트가 503 으로 닫힙니다.
CRON_SECRET=

# 알림 발송 창(분). 스케줄러 주기보다 길게 잡아야 알림이 새지 않습니다.
# 기본 10분 / cron 5분 주기 조합을 권장합니다.
PUSH_WINDOW_MINUTES=10

# -----------------------------------------------------------------------------
# 아래는 Phase 3(검진 자동판독)에서 사용합니다. 지금은 비워 두세요.
# -----------------------------------------------------------------------------

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되므로 절대 금지.
ANTHROPIC_API_KEY=
